<?xml version="1.0" encoding="utf-8"?>
<!-- 試し用の絵: 1 フレームに 1 枚ずつ限りなく出る、寿命 10 の加算の板。1 枚の明るさは 20/255
     親だけ止めた後に新しい板が出ないことと、今の板が寿命まで残ることを試しで見る (Source/Tests/effect_scene_test.cpp) -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Stream</Name>
        <CommonValues>
          <MaxGeneration>
            <Infinite>True</Infinite>
          </MaxGeneration>
          <Life>
            <Center>10</Center>
            <Max>10</Max>
            <Min>10</Min>
          </Life>
        </CommonValues>
        <RendererCommonValues>
          <!-- 2 = Add -->
          <AlphaBlend>2</AlphaBlend>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Fixed>
              <A>20</A>
            </Fixed>
          </ColorAll>
          <Sprite>
            <Position>1</Position>
            <Position_Fixed_LL>
              <X>-0.2</X>
              <Y>-0.2</Y>
            </Position_Fixed_LL>
            <Position_Fixed_LR>
              <X>0.2</X>
              <Y>-0.2</Y>
            </Position_Fixed_LR>
            <Position_Fixed_UL>
              <X>-0.2</X>
              <Y>0.2</Y>
            </Position_Fixed_UL>
            <Position_Fixed_UR>
              <X>0.2</X>
              <Y>0.2</Y>
            </Position_Fixed_UR>
          </Sprite>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>100</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
