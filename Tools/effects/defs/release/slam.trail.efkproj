<?xml version="1.0" encoding="utf-8"?>
<!-- 注: 編集ソフトの読み込みは注釈で落ちる。efkbuild.py が注釈を外した写しを作って渡す
     突進の尾 (C7)。放したフレーム u に出す。当たったら止めの頭 c で、当たらずに突進が終わったら終わったフレームで
     ChargeEffects が親を止め、出ていた点は寿命で消える (止めの間に伸びない)。止めた 6 フレーム後に消す
     動的入力 0 番は放した時の溜め量 0..1。既定の 1 は efkprobe で溜めきりの姿を見るため -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <!-- 突進の尾。1 フレームに 1 点を玉の中心から 0.65 m 後ろ (根の -Z) に置き、点は世界に残す。
           点の寿命 6 フレームで
           尾の長さは 6 フレームぶん (20 m/s で 2 m)。幅は玉の直径 × (0.25 + 0.25 × 溜め量)。視点へ向けた帯
           頭を玉の縁の後ろに置き、描く時の補間で玉より先に出る分 (1 フレーム最大 0.33 m) を玉の中に隠す
           下塗りは水色寄りの濃い青、光は白水色で幅 6 割。どちらも点の寿命で透明へ -->
      <Node>
        <Name>TrailPaint</Name>
        <CommonValues>
          <MaxGeneration>
            <Infinite>True</Infinite>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
        </CommonValues>
        <LocationValues>
          <Fixed>
            <Location>
              <Z>-0.65</Z>
            </Location>
          </Fixed>
        </LocationValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>0</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/charge_trail.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <Type>3</Type>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>60</Center>
                  <Max>60</Max>
                  <Min>60</Min>
                </R>
                <G>
                  <Center>160</Center>
                  <Max>160</Max>
                  <Min>160</Min>
                </G>
                <B>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </B>
                <A>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>60</Center>
                  <Max>60</Max>
                  <Min>60</Min>
                </R>
                <G>
                  <Center>160</Center>
                  <Max>160</Max>
                  <Min>160</Min>
                </G>
                <B>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </B>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </Easing>
          </ColorAll>
          <Ribbon>
            <ViewpointDependent>True</ViewpointDependent>
          </Ribbon>
        </DrawingValues>
      </Node>
      <Node>
        <Name>TrailAdd</Name>
        <CommonValues>
          <MaxGeneration>
            <Infinite>True</Infinite>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
        </CommonValues>
        <LocationValues>
          <Fixed>
            <Location>
              <Z>-0.65</Z>
            </Location>
          </Fixed>
        </LocationValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>1</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/charge_trail.png</ColorTexture>
          <AlphaBlend>2</AlphaBlend>
          <EmissiveScaling>1.2</EmissiveScaling>
        </RendererCommonValues>
        <DrawingValues>
          <Type>3</Type>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </R>
                <G>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </G>
                <A>
                  <Center>230</Center>
                  <Max>230</Max>
                  <Min>230</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </R>
                <G>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </G>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </Easing>
          </ColorAll>
          <Ribbon>
            <ViewpointDependent>True</ViewpointDependent>
          </Ribbon>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>TrailWidth</Name>
        <Code>@O.x = 1.3 * (0.25 + 0.25 * @In0)
@O.y = 1
@O.z = 1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>TrailCoreWidth</Name>
        <Code>@O.x = 1.3 * 0.6 * (0.25 + 0.25 * @In0)
@O.y = 1
@O.z = 1</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <!-- 編集ソフトの再生の範囲。実行側には渡らないが、無いと編集ソフトの読み込みが落ちる -->
  <StartFrame>0</StartFrame>
  <EndFrame>20</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
