<?xml version='1.0' encoding='utf-8'?>
<!-- 入力0は保持の最終フレーム、入力1は威力。根は等倍。
     素材が直径と面積の変化を持ち、親の停止後は保持の末尾の大きさを保つ。 -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Floor</Name>
        <CommonValues>
          <Life>
            <Center>120</Center>
            <Max>120</Max>
            <Min>120</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
          <Removal>
            <WhenParentIsRemoved>True</WhenParentIsRemoved>
          </Removal>
        </CommonValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_glow.png</ColorTexture>
          <AlphaBlend>2</AlphaBlend>
          <FadeOutType>2</FadeOutType>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>2</Billboard>
          </Sprite>
          <ColorAll>
            <Fixed>
              <G>150</G>
              <B>60</B>
              <A>122</A>
            </Fixed>
          </ColorAll>
        </DrawingValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>0</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
      </Node>
      <Node>
        <Name>Hot</Name>
        <CommonValues>
          <Life>
            <Center>120</Center>
            <Max>120</Max>
            <Min>120</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
          <Removal>
            <WhenParentIsRemoved>True</WhenParentIsRemoved>
          </Removal>
        </CommonValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.4</X>
              <Y>0.4</Y>
              <Z>0.4</Z>
              <DynamicEquation>0</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_glow.png</ColorTexture>
          <AlphaBlend>2</AlphaBlend>
          <FadeOutType>2</FadeOutType>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>2</Billboard>
          </Sprite>
          <ColorAll>
            <Fixed>
              <G>170</G>
              <B>90</B>
              <A>82</A>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>10</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>Shape</Name>
        <Code>t = @GTime * 60
f = (t + 0.5) - ((t + 0.5) % 1)
h = 1 + (@In0 - 1) * step(1, @In0)
f = f + (h - f) * step(h, f)
p = step(3, f) - step(4, f)
l = step(4, f)
span = h - 1
span = 1 + (span - 1) * step(1, span)
a = 0.9 * (1 - p - l) + p + l * (h + 2 - f) / span
r = (1 + a) * 0.5
r = (r + a / r) * 0.5
r = (r + a / r) * 0.5
r = (r + a / r) * 0.5
r = (r + a / r) * 0.5
r = (r + a / r) * 0.5
@O.x = @P.x * r * (2 + 1.6 * @In1)
@O.y = @P.y * r * (2 + 1.6 * @In1)
@O.z = @P.z * r * (2 + 1.6 * @In1)</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
</EffekseerProject>