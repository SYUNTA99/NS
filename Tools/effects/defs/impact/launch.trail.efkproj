<?xml version="1.0" encoding="utf-8"?>
<!-- 飛び出しの尾 launch.trail: 飛ばした相手が飛ぶ向きと勢いを、相手の後ろに残る帯で見せる
     ImpactEffects が明け R に相手の中心へ出し、毎フレーム相手の中心へ置き直す。曲線から剛体へ渡ったのを読んだ
     フレームに帯も輪もまとめて消す (手本のスマブラは尾が着地の切り替えのコマで消える)
     帯の後ろに、飛ぶ向きを法線にした輪を 3 フレームごとに残す
     再生の大きさが相手の直径 (m)。帯の幅は直径の 0.4 (下塗り) と 0.25 (芯)。点は世界に残し、玉の中心から後ろへ並ぶ
     再生の向きの +Y が飛ぶ向き。視点に依る帯は、点の +Y と視線の両方に直角な向きへ幅を取る。点は出た時の向きを持ち続ける
     動的入力 0 番が 1 なら橙、1 番が 1 なら大きな外れの灰。2 番が点の寿命 (帯が残るフレーム数、8 + 4 × 飛ばしの比)
     既定の入力は efkprobe で橙の姿を見るため -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <!-- 橙の下塗り (255, 150, 60)、不透明度 0.75。白い床の上でも色で読めるよう半透明で塗る。尾へ向かって細り、透明へ -->
      <Node>
        <Name>Paint</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <RotationEffectType>1</RotationEffectType>
          <Life>
            <DynamicEquationMax>2</DynamicEquationMax>
            <DynamicEquationMin>2</DynamicEquationMin>
          </Life>
        </CommonValues>
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.4</Center>
                <Max>0.4</Max>
                <Min>0.4</Min>
              </X>
            </Start>
            <End>
              <X>
                <Center>0.14</Center>
                <Max>0.14</Max>
                <Min>0.14</Min>
              </X>
            </End>
          </Easing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_ribbon.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <Type>3</Type>
          <Ribbon>
            <ViewpointDependent>True</ViewpointDependent>
            <!-- 2 = イージング。帯の色は板の色の欄 (DrawingValues/ColorAll) でなく帯の欄に置く -->
            <ColorAll>2</ColorAll>
            <ColorAll_Easing>
              <Start>
                <G>
                  <Center>150</Center>
                  <Max>150</Max>
                  <Min>150</Min>
                </G>
                <B>
                  <Center>60</Center>
                  <Max>60</Max>
                  <Min>60</Min>
                </B>
                <A>
                  <Center>190</Center>
                  <Max>190</Max>
                  <Min>190</Min>
                </A>
              </Start>
              <End>
                <G>
                  <Center>150</Center>
                  <Max>150</Max>
                  <Min>150</Min>
                </G>
                <B>
                  <Center>60</Center>
                  <Max>60</Max>
                  <Min>60</Min>
                </B>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </ColorAll_Easing>
          </Ribbon>
        </DrawingValues>
      </Node>
      <!-- 芯 (255, 225, 190) を半透明で重ねる。加算にすると下塗りと足して 1 を超え、にじみで白く飛んで橙が消えた -->
      <Node>
        <Name>Core</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <RotationEffectType>1</RotationEffectType>
          <Life>
            <DynamicEquationMax>2</DynamicEquationMax>
            <DynamicEquationMin>2</DynamicEquationMin>
          </Life>
        </CommonValues>
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.25</Center>
                <Max>0.25</Max>
                <Min>0.25</Min>
              </X>
            </Start>
            <End>
              <X>
                <Center>0.09</Center>
                <Max>0.09</Max>
                <Min>0.09</Min>
              </X>
            </End>
          </Easing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_ribbon.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <Type>3</Type>
          <Ribbon>
            <ViewpointDependent>True</ViewpointDependent>
            <!-- 2 = イージング。帯の色は板の色の欄 (DrawingValues/ColorAll) でなく帯の欄に置く -->
            <ColorAll>2</ColorAll>
            <ColorAll_Easing>
              <Start>
                <G>
                  <Center>225</Center>
                  <Max>225</Max>
                  <Min>225</Min>
                </G>
                <B>
                  <Center>190</Center>
                  <Max>190</Max>
                  <Min>190</Min>
                </B>
                <A>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </A>
              </Start>
              <End>
                <G>
                  <Center>225</Center>
                  <Max>225</Max>
                  <Min>225</Min>
                </G>
                <B>
                  <Center>190</Center>
                  <Max>190</Max>
                  <Min>190</Min>
                </B>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </ColorAll_Easing>
          </Ribbon>
        </DrawingValues>
      </Node>
      <!-- 大きな外れの灰 (170, 170, 170)。明るさを上げず、加算もしない -->
      <Node>
        <Name>WidePaint</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>1</DynamicEquation>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <RotationEffectType>1</RotationEffectType>
          <Life>
            <DynamicEquationMax>2</DynamicEquationMax>
            <DynamicEquationMin>2</DynamicEquationMin>
          </Life>
        </CommonValues>
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.4</Center>
                <Max>0.4</Max>
                <Min>0.4</Min>
              </X>
            </Start>
            <End>
              <X>
                <Center>0.14</Center>
                <Max>0.14</Max>
                <Min>0.14</Min>
              </X>
            </End>
          </Easing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_ribbon.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <Type>3</Type>
          <Ribbon>
            <ViewpointDependent>True</ViewpointDependent>
            <!-- 2 = イージング。帯の色は板の色の欄 (DrawingValues/ColorAll) でなく帯の欄に置く -->
            <ColorAll>2</ColorAll>
            <ColorAll_Easing>
              <Start>
                <R>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </R>
                <G>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </G>
                <B>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </B>
                <A>
                  <Center>190</Center>
                  <Max>190</Max>
                  <Min>190</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </R>
                <G>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </G>
                <B>
                  <Center>170</Center>
                  <Max>170</Max>
                  <Min>170</Min>
                </B>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </ColorAll_Easing>
          </Ribbon>
        </DrawingValues>
      </Node>
      <!-- 白い輪 (不透明度 0.9)。3 フレームごとに相手の中心に置き、その場に残す。法線が飛ぶ向き
           手本のスマブラは白い輪が 2〜3 フレームおきに飛ぶ物の所に新しく出て後ろへ残り、同時に 1〜2 本見える
           寿命 6 で同時に 2 本。半径は直径の 0.8 倍から 1.2 倍へ広がり (直径 1.5 m で 1.2 m から 1.8 m)、
           相手の輪郭 (直径の 0.5 倍) の外を回る。手本の輪も飛ぶ物より一回り大きい。最後の 3 フレームで薄れる -->
      <Node>
        <Name>Wake</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <RotationEffectType>1</RotationEffectType>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>3</Center>
              <Max>3</Max>
              <Min>3</Min>
            </GenerationTime>
          </Generation>
        </CommonValues>
        <!-- 輪は XY 面に置かれる (法線が +Z)。X まわりに 90 度回し、法線を再生の +Y (飛ぶ向き) へ向ける -->
        <RotationValues>
          <Fixed>
            <Rotation>
              <X>90</X>
            </Rotation>
          </Fixed>
        </RotationValues>
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </X>
              <Y>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </Y>
              <Z>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </Z>
            </Start>
            <End>
              <X>
                <Center>1.2</Center>
                <Max>1.2</Max>
                <Min>1.2</Min>
              </X>
              <Y>
                <Center>1.2</Center>
                <Max>1.2</Max>
                <Min>1.2</Min>
              </Y>
              <Z>
                <Center>1.2</Center>
                <Max>1.2</Max>
                <Min>1.2</Min>
              </Z>
            </End>
          </Easing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_band.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Type>4</Type>
          <Ring>
            <VertexCount>48</VertexCount>
            <Outer_Fixed>
              <Location>
                <X>1</X>
              </Location>
            </Outer_Fixed>
            <Inner_Fixed>
              <Location>
                <X>0.95</X>
              </Location>
            </Inner_Fixed>
            <OuterColor_Fixed>
              <A>230</A>
            </OuterColor_Fixed>
            <CenterColor_Fixed>
              <A>230</A>
            </CenterColor_Fixed>
            <InnerColor_Fixed>
              <A>230</A>
            </InnerColor_Fixed>
          </Ring>
        </DrawingValues>
      </Node>
      <!-- 大きな外れの灰の輪。帯と同じ灰 (170, 170, 170) で、形と間隔は白い輪と同じ -->
      <Node>
        <Name>WideWake</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>1</DynamicEquation>
          </MaxGeneration>
          <LocationEffectType>1</LocationEffectType>
          <RotationEffectType>1</RotationEffectType>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>3</Center>
              <Max>3</Max>
              <Min>3</Min>
            </GenerationTime>
          </Generation>
        </CommonValues>
        <!-- 輪は XY 面に置かれる (法線が +Z)。X まわりに 90 度回し、法線を再生の +Y (飛ぶ向き) へ向ける -->
        <RotationValues>
          <Fixed>
            <Rotation>
              <X>90</X>
            </Rotation>
          </Fixed>
        </RotationValues>
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </X>
              <Y>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </Y>
              <Z>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </Z>
            </Start>
            <End>
              <X>
                <Center>1.2</Center>
                <Max>1.2</Max>
                <Min>1.2</Min>
              </X>
              <Y>
                <Center>1.2</Center>
                <Max>1.2</Max>
                <Min>1.2</Min>
              </Y>
              <Z>
                <Center>1.2</Center>
                <Max>1.2</Max>
                <Min>1.2</Min>
              </Z>
            </End>
          </Easing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_band.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Type>4</Type>
          <Ring>
            <VertexCount>48</VertexCount>
            <Outer_Fixed>
              <Location>
                <X>1</X>
              </Location>
            </Outer_Fixed>
            <Inner_Fixed>
              <Location>
                <X>0.95</X>
              </Location>
            </Inner_Fixed>
            <OuterColor_Fixed>
              <R>170</R>
              <G>170</G>
              <B>170</B>
            </OuterColor_Fixed>
            <CenterColor_Fixed>
              <R>170</R>
              <G>170</G>
              <B>170</B>
            </CenterColor_Fixed>
            <InnerColor_Fixed>
              <R>170</R>
              <G>170</G>
              <B>170</B>
            </InnerColor_Fixed>
          </Ring>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>15</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <!-- 1 回の飛行で出す点の上限。1 フレーム 1 点で、渡るまで 10 秒の飛行でも足りる数 -->
      <DynamicEquation>
        <Name>OrangeCount</Name>
        <Code>@O.x = @In0 * 600</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>GrayCount</Name>
        <Code>@O.x = @In1 * 600</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>Life</Name>
        <Code>@O.x = @In2</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
