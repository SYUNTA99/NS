<?xml version='1.0' encoding='utf-8'?>
<!-- 水に落ちた時のしぶき。入力は無く、根は等倍。ゲームは水面の位置に置くだけで、向きは回さない。
     水面から上へ飛んで落ちる粒と、水面に広がる輪の 2 つ。小さなしぶきにして、失敗を重く見せない
     (計画 R08-11-14-03。値は出発点で、記録は .planning/records/衝突の手触り.md) -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Drops</Name>
        <CommonValues>
          <MaxGeneration>
            <Value>36</Value>
          </MaxGeneration>
          <Life>
            <Center>30</Center>
            <Max>36</Max>
            <Min>24</Min>
          </Life>
          <!-- 間隔 0 と開始 -1 で、全部の粒を 1 フレーム目に出す (Tools/effects/README.md) -->
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 1 = PVA。生成位置の回転で各粒の +Y が上から少し外へ傾くので、+Y の速度が上へ広がる向きになる。
             速さ 0.3 と重力 0.024 で、約 1.9 m 上がって、25 フレームほどで水面へ落ちる -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <Y>
                <Center>0.3</Center>
                <Max>0.4</Max>
                <Min>0.2</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.024</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>1.55</Center>
                <Max>2</Max>
                <Min>1.1</Min>
              </X>
              <Y>
                <Center>1.55</Center>
                <Max>2</Max>
                <Min>1.1</Min>
              </Y>
              <Z>
                <Center>1.55</Center>
                <Max>2</Max>
                <Min>1.1</Min>
              </Z>
            </Start>
            <End>
              <X>
                <Center>0.45</Center>
                <Max>0.45</Max>
                <Min>0.45</Min>
              </X>
              <Y>
                <Center>0.45</Center>
                <Max>0.45</Max>
                <Min>0.45</Min>
              </Y>
              <Z>
                <Center>0.45</Center>
                <Max>0.45</Max>
                <Min>0.45</Min>
              </Z>
            </End>
          </Easing>
        </ScalingValues>
        <!-- 1 = Sphere。半径 0.4 の輪の上に置き、上から 10〜40 度だけ外へ傾ける (RotationX は真上からの傾き。90 で水平) -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.4</Center>
              <Max>0.4</Max>
              <Min>0.4</Min>
            </Radius>
            <RotationX>
              <Center>25</Center>
              <Max>40</Max>
              <Min>10</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_puff.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>8</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Fixed>
              <R>225</R>
              <G>242</G>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>Ripple</Name>
        <CommonValues>
          <Life>
            <Center>26</Center>
            <Max>26</Max>
            <Min>26</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 輪を水面に寝かせる。水面の板と同じ高さでは隠れるので、少し上に置く -->
        <LocationValues>
          <Fixed>
            <Location>
              <Y>0.06</Y>
            </Location>
          </Fixed>
        </LocationValues>
        <RotationValues>
          <Fixed>
            <Rotation>
              <X>90</X>
            </Rotation>
          </Fixed>
        </RotationValues>
        <!-- 2 = イージング。半径 0.4 から 3 へ広がる -->
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.4</Center>
                <Max>0.4</Max>
                <Min>0.4</Min>
              </X>
              <Y>
                <Center>0.4</Center>
                <Max>0.4</Max>
                <Min>0.4</Min>
              </Y>
              <Z>
                <Center>0.4</Center>
                <Max>0.4</Max>
                <Min>0.4</Min>
              </Z>
            </Start>
            <End>
              <X>
                <Center>3</Center>
                <Max>3</Max>
                <Min>3</Min>
              </X>
              <Y>
                <Center>3</Center>
                <Max>3</Max>
                <Min>3</Min>
              </Y>
              <Z>
                <Center>3</Center>
                <Max>3</Max>
                <Min>3</Min>
              </Z>
            </End>
            <Type>11</Type>
          </Easing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_band.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>14</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Type>4</Type>
          <Ring>
            <VertexCount>48</VertexCount>
            <Outer_Fixed>
              <Location>
                <X>1</X>
              </Location>
            </Outer_Fixed>
            <Inner_Fixed>
              <Location>
                <X>0.8</X>
              </Location>
            </Inner_Fixed>
          </Ring>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>40</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
