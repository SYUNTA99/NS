<?xml version='1.0' encoding='utf-8'?>
<!-- 入力0は当たりから数えた保持の最終フレーム、入力1は威力。根は等倍。
     当たりの1フレーム目に再生する。素材が長さ・脈動・太さの変化を持つ。 -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Base</Name>
        <CommonValues>
          <Life>
            <Center>120</Center>
            <Max>120</Max>
            <Min>120</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <Y>0.16</Y>
              <DynamicEquation>0</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <DepthValues>
          <DepthOffset>0.4</DepthOffset>
        </DepthValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_line.png</ColorTexture>
          <FadeOutType>2</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Fixed>
              <G>160</G>
              <B>60</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>Hot</Name>
        <CommonValues>
          <Life>
            <Center>120</Center>
            <Max>120</Max>
            <Min>120</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.7</X>
              <Y>0.08</Y>
              <DynamicEquation>0</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <DepthValues>
          <DepthOffset>0.45</DepthOffset>
        </DepthValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_line.png</ColorTexture>
          <AlphaBlend>2</AlphaBlend>
          <EmissiveScaling>2.5</EmissiveScaling>
          <FadeOutType>2</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Fixed>
              <G>235</G>
              <B>200</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>10</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>Shape</Name>
        <Code>t = @GTime * 60
f = (t + 0.5) - ((t + 0.5) % 1)
f = f + 1
h = 1 + (@In0 - 1) * step(1, @In0)
t = (f - 1) / h
t = t + (1 - t) * step(1, t)
p = 0.85 + 0.15 * step(0, sin((f - 0.5) * 3.141592653589793))
p = 1 + (p - 1) * (1 - step(h + 0.5, f))
@O.x = @P.x * p * (4 + 2 * @In1)
@O.y = @P.y * (1 + (0.3 - 1) * t)
@O.z = @P.z</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
</EffekseerProject>