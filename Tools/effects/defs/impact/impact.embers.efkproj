<?xml version='1.0' encoding='utf-8'?>
<!-- 入力0は威力、1は飛ばしの比。粒数と速さへの変換は素材が持つ。
     根の大きさは1。向きと位置、核が落ちるフレームとの同期はGameが渡す。 -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Embers</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <!-- 8〜10 フレーム。11 に出て、薄れながら 18〜20 が最後 (手本は 19〜20 まで) -->
          <Life>
            <Center>9</Center>
            <Max>10</Max>
            <Min>8</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 1 = PVA。生まれた所の回転で各粒の +Y が外を向き、+Y の速さが外へ散る速さ -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>1</DynamicEquationMin>
              <DynamicEquationMax>2</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 火花と同じ 15 m/s² を 1 フレームの 2 乗へ直した 0.0042。散った粒が弧を描いて落ちる -->
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 幅 0.05 m・長さ 0.16 m。放射の筋 (0.05・0.35) より短い粒で、遅い粒は点、速い粒は短い筋に見える -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.05</X>
              <Y>0.16</Y>
            </Scale>
          </Fixed>
        </ScalingValues>
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.3</Center>
              <Max>0.3</Max>
              <Min>0.3</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>180</Max>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 橙黄から暗い赤へ落ち、1 を超えない。1.5 倍で出た直後の芯をにじませた時は、200 粒のにじみが接触点で 1 つの
               黄白の塊になり、核が消えた後の 12 にも光の塊が残って見えた -->
        </RendererCommonValues>
        <DrawingValues>
          <!-- 4 = 進む向きに縦を合わせる -->
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.72</ColorG>
                  <ColorB>0.3</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.42</ColorG>
                  <ColorB>0.08</ColorB>
                  <Position>0.4</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.45</ColorR>
                  <ColorG>0.06</ColorG>
                  <ColorB>0.03</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>0.6</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>EmberCount</Name>
        <Code>s = (@In0 - 0.7) / (2 - 0.7)
s = s * step(0, s)
s = s + (1 - s) * step(1, s)
n = 10 + 20 * s + 0.5
n = n - (n % 1)
@O.x = n * 7</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>SpeedMin</Name>
        <Code>@O.y = (6 + 3 * @In1) / 60 * 0.3</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>SpeedMax</Name>
        <Code>@O.y = (6 + 3 * @In1) / 60</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>20</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
