      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>Count</Name>
        <Code>m = @In1 * @In1
m = m + (4 - m) * step(4, m)
n = m + 0.5
@O.x = 4 + n - (n % 1)</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>Strength</Name>
        <Code>g = 1 + 0.5 * (@In0 - 1)
g = g * step(0, g)
s = (0.8 + 0.3 * @In1) * g
@O.x = s
@O.y = s
@O.z = s</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>Away</Name>
        <Code>g = 1 + 0.5 * (@In0 - 1)
g = g * step(0, g)
s = (0.8 + 0.3 * @In1) * g
@O.x = @In2 * s * 0.7
@O.y = 0
@O.z = 0 - @In3 * s * 0.7</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
