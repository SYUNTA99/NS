<?xml version="1.0" encoding="utf-8"?>
<!-- 当たりの粉 impact.dust: 相手が置かれていた床から舞う土ぼこり
     動的入力 0 番が塊の数。再生の大きさが塊の大きさの倍率 (1 で直径 1 m)。再生の位置は床の上
     塊は床の上の半径 0.5 m の輪に生まれ、ゆっくり上へ舞いながら 0.6 倍から 1.4 倍へ膨らむ
     寿命 24 フレームの後、取り除かれてから 6 フレームで消え、明けから 30 フレームで無くなる。
     親を止めると (次の当たり)、その時から 6 フレームで消える -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Puff</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>24</Center>
            <Max>24</Max>
            <Min>24</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
          <Removal>
            <WhenParentIsRemoved>True</WhenParentIsRemoved>
          </Removal>
        </CommonValues>
        <!-- 塊の中心を床から 0.45 m 上に置く。板はカメラへ向くので、床に中心を置くと下半分が床に切られて山形に見える
             上へ 0.012〜0.02 m/フレーム、横は ±0.01 m/フレーム。1 フレームごとに 0.0006 ずつ遅くなる -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <Y>
                <Center>0.45</Center>
                <Max>0.45</Max>
                <Min>0.45</Min>
              </Y>
            </Location>
            <Velocity>
              <X>
                <Max>0.01</Max>
                <Min>-0.01</Min>
              </X>
              <Y>
                <Center>0.016</Center>
                <Max>0.02</Max>
                <Min>0.012</Min>
              </Y>
              <Z>
                <Max>0.01</Max>
                <Min>-0.01</Min>
              </Z>
            </Velocity>
            <Acceleration>
              <Y>
                <Center>-0.0006</Center>
                <Max>-0.0006</Max>
                <Min>-0.0006</Min>
              </Y>
            </Acceleration>
          </PVA>
        </LocationValues>
        <!-- 2 = イージング。寿命の間に 0.6 倍から 1.4 倍へ膨らむ -->
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.6</Center>
                <Max>0.6</Max>
                <Min>0.6</Min>
              </X>
              <Y>
                <Center>0.6</Center>
                <Max>0.6</Max>
                <Min>0.6</Min>
              </Y>
              <Z>
                <Center>0.6</Center>
                <Max>0.6</Max>
                <Min>0.6</Min>
              </Z>
            </Start>
            <End>
              <X>
                <Center>1.4</Center>
                <Max>1.4</Max>
                <Min>1.4</Min>
              </X>
              <Y>
                <Center>1.4</Center>
                <Max>1.4</Max>
                <Min>1.4</Min>
              </Y>
              <Z>
                <Center>1.4</Center>
                <Max>1.4</Max>
                <Min>1.4</Min>
              </Z>
            </End>
          </Easing>
        </ScalingValues>
        <!-- 1 = 球。半径 0.5 m の水平の輪 (+Y から 90 度) に置く。塊の向きは回さない -->
        <GenerationLocationValues>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.5</Center>
              <Max>0.6</Max>
              <Min>0.4</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>90</Max>
              <Min>90</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_puff.png</ColorTexture>
          <FadeOutType>2</FadeOutType>
          <FadeOut>
            <Frame>6</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <!-- 砂色 (190, 178, 158)。出始めの 1 割で濃くなり、後の 6 割で薄れる -->
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>0.745</ColorR>
                  <ColorG>0.698</ColorG>
                  <ColorB>0.62</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.745</ColorR>
                  <ColorG>0.698</ColorG>
                  <ColorB>0.62</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>0.35</Alpha>
                </Key>
                <Key>
                  <Position>0.1</Position>
                  <Alpha>0.7</Alpha>
                </Key>
                <Key>
                  <Position>0.4</Position>
                  <Alpha>0.6</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0.15</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>5</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>Count</Name>
        <Code>@O.x = @In0</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>40</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
