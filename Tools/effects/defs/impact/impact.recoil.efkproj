<?xml version="1.0" encoding="utf-8"?>
<!-- 弾かれ線 impact.recoil: 当てた側 (自機) が弾かれる向き
     ゲームは玉の縁のうち反動の向きの逆の点に置き、再生の向きの +Y を自機の反動の初速の向きにする
     線はそこから +Y の 32.5 度へ開く扇で、玉の輪郭の外 (置いた点から 1.2 m 先) から外へ伸びる
     扇の線は +Y の周りを等分した向きに置く (白 8 本は 45 度おき、灰 4 本は 90 度おき)
     玉の半径 0.65 m の輪郭を置いた点から見ると、25 度の向きで 1.18 m 先まで玉の中。20 度より内の線は玉を縦に貫く
     線の中心を長さの半分だけ外へ寄せ、玉に近い端を 1.2 m に揃える (動的入力 1 番の長さから)
     扇の真ん中に、反動の向きそのものへ伸びる軸の線を 1 本置く (WhiteAxis・GrayAxis)。扇の線の 2 倍の太さと
     1.5 倍の長さで、玉に近い端を置いた点から 1.35 m (玉の直径 1.3 m の先) に置き、玉の輪郭の外に出す。
     扇だけの時は、横からの絵で線が 38〜127 度や 25〜115 度に分かれて見え、扇の軸 (反動の向き) が決まらなかった。
     円に並べた扇の線は視点の向きで開き方が変わり、手前と奥へ向く線は短く写る。軸の線は反動の向きを画面へ写した
     向きにそのまま写り、反動の向きが画面に沿う横からの絵では扇のどの線よりも太く長い
     節を動的入力の数で選ぶ。0 番が White の本数 (中心近く・惜しい)、2 番が Gray の本数 (大きな外れ)。
     軸の線は同じ段の扇の本数が 1 以上の時に 1 本 (step)。1 番が線の長さ (m)。使わない節の数は 0 にする
     線は出てから 0.18 m/フレームで外へ進み、寿命 7 フレームの後半で薄れる。明けの 4 フレーム後に出て 10 フレーム後に消える -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>White</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>3</DynamicEquationMin>
              <DynamicEquationMax>3</DynamicEquationMax>
            </Location>
            <!-- 軸から 32.5 度の向きへ 0.18 m/フレームで外へ進む (横 sin・縦 cos) -->
            <Velocity>
              <X>
                <Center>0.0967</Center>
                <Max>0.0967</Max>
                <Min>0.0967</Min>
              </X>
              <Y>
                <Center>0.1518</Center>
                <Max>0.1518</Max>
                <Min>0.1518</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 幅 0.04 m。長さは動的入力 1 番 -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>1</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <!-- 3 = 円。反動の向き (+Y) を軸に、線の数で等分した向きへ順に置く (1 = 順。分ける数は既定の 8)。
             乱数で置くと片側に偏り、
             横からの絵で扇の真ん中が反動の向きからずれて見えた。回転は軸の周りだけで、線の向きは下の位置と速さが決める -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>3</Type>
          <Circle>
            <Type>1</Type>
            <AxisDirection>1</AxisDirection>
          </Circle>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白の 1.5 倍。芯が 1 を超えてにじむ -->
          <EmissiveScaling>1.5</EmissiveScaling>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
        </DrawingValues>
      </Node>
      <Node>
        <Name>Gray</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>2</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>3</DynamicEquationMin>
              <DynamicEquationMax>3</DynamicEquationMax>
            </Location>
            <!-- 軸から 32.5 度の向きへ 0.18 m/フレームで外へ進む (横 sin・縦 cos) -->
            <Velocity>
              <X>
                <Center>0.0967</Center>
                <Max>0.0967</Max>
                <Min>0.0967</Min>
              </X>
              <Y>
                <Center>0.1518</Center>
                <Max>0.1518</Max>
                <Min>0.1518</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>1</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <!-- 3 = 円。反動の向き (+Y) を軸に、線の数で等分した向きへ順に置く (1 = 順。分ける数は 4)。
             乱数で置くと片側に偏り、
             横からの絵で扇の真ん中が反動の向きからずれて見えた。回転は軸の周りだけで、線の向きは下の位置と速さが決める -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>3</Type>
          <Circle>
            <Division>4</Division>
            <Type>1</Type>
            <AxisDirection>1</AxisDirection>
          </Circle>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <!-- 灰 (230, 230, 230) で 1 を超えない (層の表の明るさ 0.9)。170 (0.67) は横からの絵で玉の黒い升の
               上にかすかにしか見えず、自機の弾かれる向きが形から読めなかった。
               白の節の 1.5 倍とは明るさとにじみで分かれる -->
          <ColorAll>
            <Fixed>
              <R>230</R>
              <G>230</G>
              <B>230</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>WhiteAxis</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>4</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>7</DynamicEquationMin>
              <DynamicEquationMax>7</DynamicEquationMax>
            </Location>
            <!-- 反動の向き (+Y) へ扇の線と同じ 0.18 m/フレームで外へ進む -->
            <Velocity>
              <Y>
                <Center>0.18</Center>
                <Max>0.18</Max>
                <Min>0.18</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 幅 0.08 m (扇の線の 2 倍) で、長さは扇の線の 1.5 倍。扇の線と同じ太さでは、横からの絵で開いた扇の線に
             紛れ、どれが軸か見分けられなかった -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>6</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白の 1.5 倍。扇の白の線と同じ -->
          <EmissiveScaling>1.5</EmissiveScaling>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
        </DrawingValues>
      </Node>
      <Node>
        <Name>GrayAxis</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>5</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>7</DynamicEquationMin>
              <DynamicEquationMax>7</DynamicEquationMax>
            </Location>
            <!-- 反動の向き (+Y) へ扇の線と同じ 0.18 m/フレームで外へ進む -->
            <Velocity>
              <Y>
                <Center>0.18</Center>
                <Max>0.18</Max>
                <Min>0.18</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 幅 0.08 m (扇の線の 2 倍) で、長さは扇の線の 1.5 倍。扇の線と同じ太さでは、横からの絵で開いた扇の線に
             紛れ、どれが軸か見分けられなかった -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>6</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <!-- 扇の灰の線と同じ (230, 230, 230) で 1 を超えない -->
          <ColorAll>
            <Fixed>
              <R>230</R>
              <G>230</G>
              <B>230</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>8</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>1.5</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>WhiteCount</Name>
        <Code>@O.x = @In0</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>Length</Name>
        <Code>@O.x = 0.04
@O.y = @In1
@O.z = 1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>GrayCount</Name>
        <Code>@O.x = @In2</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>HalfLength</Name>
        <Code>@O.x = (1.2 + @In1 * 0.5) * 0.5373
@O.y = (1.2 + @In1 * 0.5) * 0.8434</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>WhiteAxisCount</Name>
        <Code>@O.x = step(0.5, @In0)</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>GrayAxisCount</Name>
        <Code>@O.x = step(0.5, @In2)</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>AxisLength</Name>
        <Code>@O.x = 0.08
@O.y = @In1 * 1.5
@O.z = 1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>AxisHalfLength</Name>
        <Code>@O.x = 0
@O.y = 1.35 + @In1 * 1.5 * 0.5
@O.z = 0</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
