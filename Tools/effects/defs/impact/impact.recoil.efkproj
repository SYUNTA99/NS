<?xml version='1.0' encoding='utf-8'?>
<!-- 入力0は反動の比。本数と長さを素材で決める。中心の当たりだけ再生する。
     根の大きさは1。位置は反動と逆側の玉の縁、向きは反動の初速からGameが渡す。 -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>White</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>3</DynamicEquationMin>
              <DynamicEquationMax>3</DynamicEquationMax>
            </Location>
            <!-- 軸から 32.5 度の向きへ 0.18 m/フレームで外へ進む (横 sin・縦 cos) -->
            <Velocity>
              <X>
                <Center>0.0967</Center>
                <Max>0.0967</Max>
                <Min>0.0967</Min>
              </X>
              <Y>
                <Center>0.1518</Center>
                <Max>0.1518</Max>
                <Min>0.1518</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 幅 0.04 m。長さは動的入力 1 番 -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>1</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <!-- 3 = 円。反動の向き (+Y) を軸に、線の数で等分した向きへ順に置く (1 = 順。分ける数は既定の 8)。
             乱数で置くと片側に偏り、
             横からの絵で扇の真ん中が反動の向きからずれて見えた。回転は軸の周りだけで、線の向きは下の位置と速さが決める -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>3</Type>
          <Circle>
            <Type>1</Type>
            <AxisDirection>1</AxisDirection>
          </Circle>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白の 1.5 倍。芯が 1 を超えてにじむ -->
          <EmissiveScaling>1.5</EmissiveScaling>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
        </DrawingValues>
      </Node>
      <Node>
        <Name>Gray</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>2</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>3</DynamicEquationMin>
              <DynamicEquationMax>3</DynamicEquationMax>
            </Location>
            <!-- 軸から 32.5 度の向きへ 0.18 m/フレームで外へ進む (横 sin・縦 cos) -->
            <Velocity>
              <X>
                <Center>0.0967</Center>
                <Max>0.0967</Max>
                <Min>0.0967</Min>
              </X>
              <Y>
                <Center>0.1518</Center>
                <Max>0.1518</Max>
                <Min>0.1518</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>1</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <!-- 3 = 円。反動の向き (+Y) を軸に、線の数で等分した向きへ順に置く (1 = 順。分ける数は 4)。
             乱数で置くと片側に偏り、
             横からの絵で扇の真ん中が反動の向きからずれて見えた。回転は軸の周りだけで、線の向きは下の位置と速さが決める -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>3</Type>
          <Circle>
            <Division>4</Division>
            <Type>1</Type>
            <AxisDirection>1</AxisDirection>
          </Circle>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <!-- 灰 (230, 230, 230) で 1 を超えない (層の表の明るさ 0.9)。170 (0.67) は横からの絵で玉の黒い升の
               上にかすかにしか見えず、自機の弾かれる向きが形から読めなかった。
               白の節の 1.5 倍とは明るさとにじみで分かれる -->
          <ColorAll>
            <Fixed>
              <R>230</R>
              <G>230</G>
              <B>230</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>WhiteAxis</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>4</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>7</DynamicEquationMin>
              <DynamicEquationMax>7</DynamicEquationMax>
            </Location>
            <!-- 反動の向き (+Y) へ扇の線と同じ 0.18 m/フレームで外へ進む -->
            <Velocity>
              <Y>
                <Center>0.18</Center>
                <Max>0.18</Max>
                <Min>0.18</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 幅 0.08 m (扇の線の 2 倍) で、長さは扇の線の 1.5 倍。扇の線と同じ太さでは、横からの絵で開いた扇の線に
             紛れ、どれが軸か見分けられなかった -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>6</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白の 1.5 倍。扇の白の線と同じ -->
          <EmissiveScaling>1.5</EmissiveScaling>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
        </DrawingValues>
      </Node>
      <Node>
        <Name>GrayAxis</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>5</DynamicEquation>
          </MaxGeneration>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <DynamicEquationMin>7</DynamicEquationMin>
              <DynamicEquationMax>7</DynamicEquationMax>
            </Location>
            <!-- 反動の向き (+Y) へ扇の線と同じ 0.18 m/フレームで外へ進む -->
            <Velocity>
              <Y>
                <Center>0.18</Center>
                <Max>0.18</Max>
                <Min>0.18</Min>
              </Y>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 幅 0.08 m (扇の線の 2 倍) で、長さは扇の線の 1.5 倍。扇の線と同じ太さでは、横からの絵で開いた扇の線に
             紛れ、どれが軸か見分けられなかった -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>6</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <!-- 扇の灰の線と同じ (230, 230, 230) で 1 を超えない -->
          <ColorAll>
            <Fixed>
              <R>230</R>
              <G>230</G>
              <B>230</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>WhiteCount</Name>
        <Code>@O.x = 8</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>Length</Name>
        <Code>@O.x = 0.04
@O.y = (0.6 + 0.5 * @In0)
@O.z = 1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>GrayCount</Name>
        <Code>@O.x = 0</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>HalfLength</Name>
        <Code>@O.x = (1.2 + (0.6 + 0.5 * @In0) * 0.5) * 0.5373
@O.y = (1.2 + (0.6 + 0.5 * @In0) * 0.5) * 0.8434</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>WhiteAxisCount</Name>
        <Code>@O.x = 1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>GrayAxisCount</Name>
        <Code>@O.x = 0</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>AxisLength</Name>
        <Code>@O.x = 0.08
@O.y = (0.6 + 0.5 * @In0) * 1.5
@O.z = 1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>AxisHalfLength</Name>
        <Code>@O.x = 0
@O.y = 1.35 + (0.6 + 0.5 * @In0) * 1.5 * 0.5
@O.z = 0</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
