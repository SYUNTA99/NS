<?xml version="1.0" encoding="utf-8"?>
<!-- 火花 impact.sparks: 力が相手へ入った向きと量
     3 つの節を動的入力の数で選ぶ。0 番が Band の粒の数 (中心近く)、3 番が NearBand の粒の数 (惜しい)、
     1 番が Scrape の粒の数 (大きな外れ)、2 番が速さ (m/フレーム)。使わない節の数は 0 にする
     Band と NearBand: 再生の向きの +Y を相手の飛ぶ向きにする。生まれる所は接触点から 0.5 m 外の、+Y に直角な輪。
       そこから +Y の 35 度の円錐の向きへ飛ぶ (層の表の半角 35 度)。帯の真横 (90 度) へ出すと横からの絵で縦の線に潰れ、
       相手の飛ぶ向きが形に出なかった。接触点から 35 度で出すと相手の体の中へ入って隠れる。
       0.5 m 外の輪から出ると、相手の玉 (半径 0.75 m) の外を回って前へ開く (0.3 m では出てすぐ玉の中を通る)
     Scrape: 再生の向きの +Y を横ずれの側と相手の飛ぶ向きと上の間にし、+Y の 45 度の円錐へ擦れて飛ぶ
     全部の粒を最初の更新で出す (生成の間隔 0 と開始 -1)。重力はワールドの下向きで、再生の向きに依らない -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Band</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <!-- 6〜8 フレーム。中心近くは 3 フレーム目に出て、薄れながら 8〜10 が最後。
               手本の弾きは塊の中の放射の筋が 3〜10 で、11 からは新しく弾ける火の粉 (impact.embers) に替わる。
               周回 3 までは 12〜20 で 20 ごろまで飛び続け、11 に新しい散りが無かった -->
          <Life>
            <Center>7</Center>
            <Max>8</Max>
            <Min>6</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 1 = PVA。生まれた所の回転で各粒の +Y が外を向き、+Y の速さが放射になる。速さは動的入力 2 番の 0.8〜1.2 倍
             粒の局所の Z が再生の向きの +Y の逆なので、Z に負の速さを入れると相手の飛ぶ向きへ進む (efkprobe で確かめた)。
             外へ sin 35 度・前へ cos 35 度に分け、速さの大きさは動的入力 2 番のまま -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>5</DynamicEquationMin>
              <DynamicEquationMax>6</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 15 m/s² を 1 フレームの 2 乗へ直した 0.0042。火の粉が弧を描いて落ちる -->
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 細い筋: 幅 0.05 m・長さ 0.35 m -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.05</X>
              <Y>0.35</Y>
            </Scale>
          </Fixed>
        </ScalingValues>
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.5</Center>
              <Max>0.5</Max>
              <Min>0.5</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>100</Max>
              <Min>80</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白黄から始めて 2 倍。出た直後は白く飛んでにじみ、冷えると橙から暗い赤へ落ちる -->
          <EmissiveScaling>2</EmissiveScaling>
        </RendererCommonValues>
        <DrawingValues>
          <!-- 4 = 進む向きに縦を合わせる -->
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.94</ColorG>
                  <ColorB>0.7</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.5</ColorG>
                  <ColorB>0.12</ColorB>
                  <Position>0.4</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.5</ColorR>
                  <ColorG>0.08</ColorG>
                  <ColorB>0.04</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>0.7</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>NearBand</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>4</DynamicEquation>
          </MaxGeneration>
          <!-- 18〜26 フレーム。惜しいは止めの頭に出て、見えるのは 23 ごろまで。
               手本のガードは火花が 24 でも見える。12〜20 では 17 が最後で 7 フレーム早かった -->
          <Life>
            <Center>22</Center>
            <Max>26</Max>
            <Min>18</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 1 = PVA。生まれた所の回転で各粒の +Y が外を向き、+Y の速さが放射になる。速さは動的入力 2 番の 0.8〜1.2 倍
             粒の局所の Z が再生の向きの +Y の逆なので、Z に負の速さを入れると相手の飛ぶ向きへ進む (efkprobe で確かめた)。
             外へ sin 35 度・前へ cos 35 度に分け、速さの大きさは動的入力 2 番のまま -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>5</DynamicEquationMin>
              <DynamicEquationMax>6</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 15 m/s² を 1 フレームの 2 乗へ直した 0.0042。火の粉が弧を描いて落ちる -->
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 細い筋: 幅 0.05 m・長さ 0.35 m -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.05</X>
              <Y>0.35</Y>
            </Scale>
          </Fixed>
        </ScalingValues>
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.5</Center>
              <Max>0.5</Max>
              <Min>0.5</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>100</Max>
              <Min>80</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白黄から始めて 2 倍。出た直後は白く飛んでにじみ、冷えると橙から暗い赤へ落ちる -->
          <EmissiveScaling>2</EmissiveScaling>
        </RendererCommonValues>
        <DrawingValues>
          <!-- 4 = 進む向きに縦を合わせる -->
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.94</ColorG>
                  <ColorB>0.7</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.5</ColorG>
                  <ColorB>0.12</ColorB>
                  <Position>0.4</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.5</ColorR>
                  <ColorG>0.08</ColorG>
                  <ColorB>0.04</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>0.7</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>Scrape</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>1</DynamicEquation>
          </MaxGeneration>
          <!-- 16〜20 フレーム。手本のガードは火花が 18〜19 まで体の周りに見える。
               8〜10 では灰の細い筋が 5 の後に見えず、13 フレーム早かった -->
          <Life>
            <Center>18</Center>
            <Max>20</Max>
            <Min>16</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>2</DynamicEquationMin>
              <DynamicEquationMax>3</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 幅 0.06 m・長さ 0.35 m。帯の火花 (0.05・0.35) と同じ長さにして、明るさを上げずに見える大きさにする -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.06</X>
              <Y>0.35</Y>
            </Scale>
          </Fixed>
        </ScalingValues>
        <!-- 擦れる向き (+Y) から 45 度までの円錐へ開く。手本のガードは 4 から火花の筋が接触点から上と横へ扇に開き、
             7〜18 は人の背丈の 0.4〜0.55 倍の範囲に残る。25 度では 8 本が接触点の横に固まり、広がりは相手の玉の
             直径の 0.25 倍ほどだった -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.05</Center>
              <Max>0.05</Max>
              <Min>0.05</Min>
            </Radius>
            <RotationX>
              <Max>45</Max>
              <Min>-45</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <!-- 核と同じ澄んだ橙 (240, 140, 50) で 1 を超えない。にじまない。手本のガードの火花は橙の筋
               灰橙 (230, 179, 128) は白い床と明けに出る当たりの粉の砂色 (190, 178, 158) に紛れ、
               7 の後に見えなかった -->
          <ColorAll>
            <Fixed>
              <R>240</R>
              <G>140</G>
              <B>50</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>20</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0.2</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>BandCount</Name>
        <Code>@O.x = @In0</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>ScrapeCount</Name>
        <Code>@O.x = @In1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>SpeedMin</Name>
        <Code>@O.y = @In2 * 0.8</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>SpeedMax</Name>
        <Code>@O.y = @In2 * 1.2</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>NearBandCount</Name>
        <Code>@O.x = @In3</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>BandSpeedMin</Name>
        <Code>@O.y = @In2 * 0.8 * 0.574
@O.z = 0 - @In2 * 0.8 * 0.819</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>BandSpeedMax</Name>
        <Code>@O.y = @In2 * 1.2 * 0.574
@O.z = 0 - @In2 * 1.2 * 0.819</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
