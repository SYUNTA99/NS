<?xml version='1.0' encoding='utf-8'?>
<!-- 入力0は威力、1は飛ばしの比、2は中心0/外れ1。3は使わない。
     粒数・速さは素材が決める。外れの全体3倍は粒と発生半径、速さへ焼き込んである。
     根の大きさは1。向きと位置はGameが渡す。 -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Band</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>0</DynamicEquation>
          </MaxGeneration>
          <!-- 6〜8 フレーム。中心近くは 3 フレーム目に出て、薄れながら 8〜10 が最後。
               手本の弾きは塊の中の放射の筋が 3〜10 で、11 からは新しく弾ける火の粉 (impact.embers) に替わる。
               周回 3 までは 12〜20 で 20 ごろまで飛び続け、11 に新しい散りが無かった -->
          <Life>
            <Center>7</Center>
            <Max>8</Max>
            <Min>6</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 1 = PVA。生まれた所の回転で各粒の +Y が外を向き、+Y の速さが放射になる。速さは威力と飛ばしから素材で決める
             粒の局所の Z が再生の向きの +Y の逆なので、Z に負の速さを入れると相手の飛ぶ向きへ進む (efkprobe で確かめた)。
             外へ sin 35 度・前へ cos 35 度に分け、速さの大きさは動的入力 2 番のまま -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>5</DynamicEquationMin>
              <DynamicEquationMax>6</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 15 m/s² を 1 フレームの 2 乗へ直した 0.0042。火の粉が弧を描いて落ちる -->
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 細い筋: 幅 0.05 m・長さ 0.35 m -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.05</X>
              <Y>0.35</Y>
            </Scale>
          </Fixed>
        </ScalingValues>
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.5</Center>
              <Max>0.5</Max>
              <Min>0.5</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>100</Max>
              <Min>80</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白黄から始めて 2 倍。出た直後は白く飛んでにじみ、冷えると橙から暗い赤へ落ちる -->
          <EmissiveScaling>2</EmissiveScaling>
        </RendererCommonValues>
        <DrawingValues>
          <!-- 4 = 進む向きに縦を合わせる -->
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.94</ColorG>
                  <ColorB>0.7</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.5</ColorG>
                  <ColorB>0.12</ColorB>
                  <Position>0.4</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.5</ColorR>
                  <ColorG>0.08</ColorG>
                  <ColorB>0.04</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>0.7</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>NearBand</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>4</DynamicEquation>
          </MaxGeneration>
          <!-- 18〜26 フレーム。惜しいは止めの頭に出て、見えるのは 23 ごろまで。
               手本のガードは火花が 24 でも見える。12〜20 では 17 が最後で 7 フレーム早かった -->
          <Life>
            <Center>22</Center>
            <Max>26</Max>
            <Min>18</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 1 = PVA。生まれた所の回転で各粒の +Y が外を向き、+Y の速さが放射になる。速さは動的入力 2 番の 0.8〜1.2 倍
             粒の局所の Z が再生の向きの +Y の逆なので、Z に負の速さを入れると相手の飛ぶ向きへ進む (efkprobe で確かめた)。
             外へ sin 35 度・前へ cos 35 度に分け、速さの大きさは動的入力 2 番のまま -->
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>5</DynamicEquationMin>
              <DynamicEquationMax>6</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <!-- 15 m/s² を 1 フレームの 2 乗へ直した 0.0042。火の粉が弧を描いて落ちる -->
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 細い筋: 幅 0.05 m・長さ 0.35 m -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.05</X>
              <Y>0.35</Y>
            </Scale>
          </Fixed>
        </ScalingValues>
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.5</Center>
              <Max>0.5</Max>
              <Min>0.5</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>100</Max>
              <Min>80</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
          <!-- 白黄から始めて 2 倍。出た直後は白く飛んでにじみ、冷えると橙から暗い赤へ落ちる -->
          <EmissiveScaling>2</EmissiveScaling>
        </RendererCommonValues>
        <DrawingValues>
          <!-- 4 = 進む向きに縦を合わせる -->
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.94</ColorG>
                  <ColorB>0.7</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>1</ColorR>
                  <ColorG>0.5</ColorG>
                  <ColorB>0.12</ColorB>
                  <Position>0.4</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.5</ColorR>
                  <ColorG>0.08</ColorG>
                  <ColorB>0.04</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>0.7</Position>
                  <Alpha>1</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
      <Node>
        <Name>Scrape</Name>
        <CommonValues>
          <MaxGeneration>
            <DynamicEquation>1</DynamicEquation>
          </MaxGeneration>
          <!-- 16〜20 フレーム。手本のガードは火花が 18〜19 まで体の周りに見える。
               8〜10 では灰の細い筋が 5 の後に見えず、13 フレーム早かった -->
          <Life>
            <Center>18</Center>
            <Max>20</Max>
            <Min>16</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Velocity>
              <DynamicEquationMin>2</DynamicEquationMin>
              <DynamicEquationMax>3</DynamicEquationMax>
            </Velocity>
          </PVA>
        </LocationValues>
        <LocationAbsValues>
          <LocalForceField1>
            <Type>8</Type>
            <Gravity>
              <Gravity>
                <Y>-0.0042</Y>
              </Gravity>
            </Gravity>
          </LocalForceField1>
        </LocationAbsValues>
        <!-- 幅 0.06 m・長さ 0.35 m。帯の火花 (0.05・0.35) と同じ長さにして、明るさを上げずに見える大きさにする -->
        <ScalingValues>
          <Fixed>
            <Scale>
              <X>0.18</X>
              <Y>1.0499999999999998</Y>
              <Z>3.0</Z>
            </Scale>
          </Fixed>
        </ScalingValues>
        <!-- 擦れる向き (+Y) から 45 度までの円錐へ開く。手本のガードは 4 から火花の筋が接触点から上と横へ扇に開き、
             7〜18 は人の背丈の 0.4〜0.55 倍の範囲に残る。25 度では 8 本が接触点の横に固まり、広がりは相手の玉の
             直径の 0.25 倍ほどだった -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.15000000000000002</Center>
              <Max>0.15000000000000002</Max>
              <Min>0.15000000000000002</Min>
            </Radius>
            <RotationX>
              <Max>45</Max>
              <Min>-45</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_spark.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <Sprite>
            <Billboard>4</Billboard>
          </Sprite>
          <!-- 核と同じ澄んだ橙 (240, 140, 50) で 1 を超えない。にじまない。手本のガードの火花は橙の筋
               灰橙 (230, 179, 128) は白い床と明けに出る当たりの粉の砂色 (190, 178, 158) に紛れ、
               7 の後に見えなかった -->
          <ColorAll>
            <Fixed>
              <R>240</R>
              <G>140</G>
              <B>50</B>
            </Fixed>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>BandCount</Name>
        <Code>s = (@In0 - 0.7) / (2 - 0.7)
s = s * step(0, s)
s = s + (1 - s) * step(1, s)
n = 10 + 20 * s + 0.5
n = n - (n % 1)
@O.x = n * (1 - step(0.5, @In2))</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>ScrapeCount</Name>
        <Code>@O.x = 16 * step(0.5, @In2)</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>SpeedMin</Name>
        <Code>@O.y = 4 / 60 * 0.8 * 3</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>SpeedMax</Name>
        <Code>@O.y = 4 / 60 * 1.2 * 3</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>NearBandCount</Name>
        <Code>@O.x = 0</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>BandSpeedMin</Name>
        <Code>@O.y = (6 + 3 * @In1) / 60 * 0.8 * 0.574
@O.z = 0 - (6 + 3 * @In1) / 60 * 0.8 * 0.819</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>BandSpeedMax</Name>
        <Code>@O.y = (6 + 3 * @In1) / 60 * 1.2 * 0.574
@O.z = 0 - (6 + 3 * @In1) / 60 * 1.2 * 0.819</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
