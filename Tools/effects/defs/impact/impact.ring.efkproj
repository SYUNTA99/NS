<?xml version='1.0' encoding='utf-8'?>
<!-- 入力0は威力。根は等倍。素材が半径と広がる曲線を持つ。
     ゲームは輪の位置と面の向き、開始と停止を決める。 -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Ring</Name>
        <CommonValues>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_band.png</ColorTexture>
          <EmissiveScaling>1.3</EmissiveScaling>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Type>4</Type>
          <Ring>
            <VertexCount>48</VertexCount>
            <Outer_Fixed>
              <Location>
                <X>1</X>
              </Location>
            </Outer_Fixed>
            <Inner_Fixed>
              <Location>
                <X>0.955</X>
              </Location>
            </Inner_Fixed>
            <OuterColor_Fixed>
              <G>140</G>
              <B>40</B>
            </OuterColor_Fixed>
            <CenterColor_Fixed>
              <G>140</G>
              <B>40</B>
            </CenterColor_Fixed>
            <InnerColor_Fixed>
              <G>140</G>
              <B>40</B>
            </InnerColor_Fixed>
          </Ring>
        </DrawingValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>0</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
  <Dynamic>
    <Inputs>
      <DynamicInput>
        <Input>1</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
      <DynamicInput>
        <Input>0</Input>
      </DynamicInput>
    </Inputs>
    <Equations>
      <DynamicEquation>
        <Name>Shape</Name>
        <Code>t = @GTime * 60
f = (t + 0.5) - ((t + 0.5) % 1)
t = f / 6
t = t + (1 - t) * step(1, t)
u = 1 - t
r = 0.3 + ((0.5 + 0.6 * @In0) - 0.3) * (1 - u * u * u)
@O.x = @P.x * r
@O.y = @P.y * r
@O.z = @P.z * r</Code>
      </DynamicEquation>
    </Equations>
  </Dynamic>
</EffekseerProject>