<?xml version="1.0" encoding="utf-8"?>
<!-- 衝撃の輪 impact.ring: 当たった面に沿って広がる細い輪
     輪は再生の向きの XY 面に置く (法線が再生の向きの Z)。再生の大きさが半径 (m)
     広がり方と消えるフレームはゲームが持つ (大きさを毎フレーム置き直す)。寿命 7 フレームの最後の 3 フレームで薄れる
     輪の向きは既定の固定 (再生の向きのまま置く) -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Ring</Name>
        <CommonValues>
          <Life>
            <Center>7</Center>
            <Max>7</Max>
            <Min>7</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_band.png</ColorTexture>
          <!-- 橙 (255, 140, 40) に 1.3。赤だけ 1 を超えてにじみ、緑は 0.71 で橙の見え方を保つ -->
          <EmissiveScaling>1.3</EmissiveScaling>
          <!-- 1 = 寿命の中で消える。最後の 3 フレームで薄れる -->
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>3</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <Type>4</Type>
          <Ring>
            <VertexCount>48</VertexCount>
            <!-- 帯の幅は半径の 4.5%。最大の半径 1.7 m で 0.077 m、線に見える細さ -->
            <Outer_Fixed>
              <Location>
                <X>1</X>
              </Location>
            </Outer_Fixed>
            <Inner_Fixed>
              <Location>
                <X>0.955</X>
              </Location>
            </Inner_Fixed>
            <!-- 輪の色は帯の外・真ん中・内の 3 つで持つ。全体の色は輪に掛からない。外と内は既定で透明 -->
            <OuterColor_Fixed>
              <G>140</G>
              <B>40</B>
            </OuterColor_Fixed>
            <CenterColor_Fixed>
              <G>140</G>
              <B>40</B>
            </CenterColor_Fixed>
            <InnerColor_Fixed>
              <G>140</G>
              <B>40</B>
            </InnerColor_Fixed>
          </Ring>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>30</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
