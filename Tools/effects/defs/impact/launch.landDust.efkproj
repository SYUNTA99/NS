<?xml version="1.0" encoding="utf-8"?>
<!-- 飛ばした物の着地の粉 launch.landDust: 飛ばした相手が床に落ちて剛体へ渡った所で輪状に広がる土ぼこり
     ImpactEffects が渡った次のフレームに相手の底へ出し、その 24 フレーム後に消す
     再生の大きさ 1 で、半径 0.4 m の輪から 1.2 m まで広がる。ゲームは (0.8 + 0.4 × 質量の平方根) ÷ 1.2 を掛け、
     重い相手ほど輪も塊も大きい。塊 12 個、寿命 24 の最後の 10 フレームで薄れる -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <Node>
        <Name>Puff</Name>
        <CommonValues>
          <MaxGeneration>
            <Value>12</Value>
          </MaxGeneration>
          <Life>
            <Center>24</Center>
            <Max>24</Max>
            <Min>24</Min>
          </Life>
          <Generation>
            <GenerationTime>
              <Center>0</Center>
              <Max>0</Max>
              <Min>0</Min>
            </GenerationTime>
            <GenerationTimeOffset>
              <Center>-1</Center>
              <Max>-1</Max>
              <Min>-1</Min>
            </GenerationTimeOffset>
          </Generation>
        </CommonValues>
        <!-- 2 = イージング。粒の +Y (外向き) へ 0.8 m 進む。EaseOutQuadratic で出た直後が速い
             始点は輪の半径 0.4 m、終点は 1.2 m (再生の大きさ 1 の時) -->
        <LocationValues>
          <Type>2</Type>
          <Easing>
            <End>
              <Y>
                <Center>0.8</Center>
                <Max>0.8</Max>
                <Min>0.8</Min>
              </Y>
            </End>
            <Type>11</Type>
          </Easing>
        </LocationValues>
        <!-- 2 = イージング。塊は 0.5 倍から 0.9 倍へ膨らむ -->
        <ScalingValues>
          <Type>2</Type>
          <Easing>
            <Start>
              <X>
                <Center>0.5</Center>
                <Max>0.5</Max>
                <Min>0.5</Min>
              </X>
              <Y>
                <Center>0.5</Center>
                <Max>0.5</Max>
                <Min>0.5</Min>
              </Y>
              <Z>
                <Center>0.5</Center>
                <Max>0.5</Max>
                <Min>0.5</Min>
              </Z>
            </Start>
            <End>
              <X>
                <Center>0.9</Center>
                <Max>0.9</Max>
                <Min>0.9</Min>
              </X>
              <Y>
                <Center>0.9</Center>
                <Max>0.9</Max>
                <Min>0.9</Min>
              </Y>
              <Z>
                <Center>0.9</Center>
                <Max>0.9</Max>
                <Min>0.9</Min>
              </Z>
            </End>
          </Easing>
        </ScalingValues>
        <!-- 1 = 球。床から 0.3 m 上の、半径 0.4 m の水平の輪 (+Y から 90 度) に置き、粒の +Y を外へ向ける
             床に中心を置くと、カメラへ向く板の下半分が床に切られる -->
        <GenerationLocationValues>
          <EffectsRotation>True</EffectsRotation>
          <Type>1</Type>
          <Sphere>
            <Radius>
              <Center>0.4</Center>
              <Max>0.4</Max>
              <Min>0.4</Min>
            </Radius>
            <RotationX>
              <Center>90</Center>
              <Max>90</Max>
              <Min>90</Min>
            </RotationX>
            <RotationY>
              <Max>180</Max>
              <Min>-180</Min>
            </RotationY>
          </Sphere>
        </GenerationLocationValues>
        <RendererCommonValues>
          <ColorTexture>Texture/impact_puff.png</ColorTexture>
          <FadeOutType>1</FadeOutType>
          <FadeOut>
            <Frame>10</Frame>
          </FadeOut>
        </RendererCommonValues>
        <DrawingValues>
          <!-- 砂色 (190, 178, 158) を半透明で。出始めの 1 割で濃くなり、後は薄れる -->
          <ColorAll>
            <Type>4</Type>
            <Gradient>
              <ColorMarkers>
                <Key>
                  <ColorR>0.745</ColorR>
                  <ColorG>0.698</ColorG>
                  <ColorB>0.62</ColorB>
                  <Position>0</Position>
                  <Intensity>1</Intensity>
                </Key>
                <Key>
                  <ColorR>0.745</ColorR>
                  <ColorG>0.698</ColorG>
                  <ColorB>0.62</ColorB>
                  <Position>1</Position>
                  <Intensity>1</Intensity>
                </Key>
              </ColorMarkers>
              <AlphaMarkers>
                <Key>
                  <Position>0</Position>
                  <Alpha>0.4</Alpha>
                </Key>
                <Key>
                  <Position>0.1</Position>
                  <Alpha>0.75</Alpha>
                </Key>
                <Key>
                  <Position>1</Position>
                  <Alpha>0.2</Alpha>
                </Key>
              </AlphaMarkers>
            </Gradient>
          </ColorAll>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <StartFrame>0</StartFrame>
  <EndFrame>40</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
