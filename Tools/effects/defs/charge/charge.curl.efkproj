<?xml version="1.0" encoding="utf-8"?>
<!-- 注: 編集ソフトの読み込みは注釈で落ちる。efkbuild.py が注釈を外した写しを作って渡す
     押した瞬間の丸まりの殻 (C1)。押したフレーム p から 6 フレーム。ChargeEffects が p + 6 に消す
     自機を包む殻が 4 フレームで玉へ縮み、足元に空気の輪が広がる。立ち姿から玉への持ち替えを隠す -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <!-- 殻は直径 2.4 m (縁の輝きの直径) から 1.4 m (玉の直径 1.3 m の少し外) へ EaseOutCubic で縮み、
           4 フレーム目で 96% 縮み終える
           殻の下塗り。白い床の上でも殻の縁が濃い青で読める (加算だけだと白い升で白くつぶれる) -->
      <Node>
        <Name>ShellPaint</Name>
        <CommonValues>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
        </CommonValues>
        <ScalingValues>
          <Type>4</Type>
          <SingleEasing>
            <Start>
              <Center>2.67</Center>
              <Max>2.67</Max>
              <Min>2.67</Min>
            </Start>
            <End>
              <Center>1.55</Center>
              <Max>1.55</Max>
              <Min>1.55</Min>
            </End>
            <Type>21</Type>
          </SingleEasing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/charge_shell.png</ColorTexture>
        </RendererCommonValues>
        <!-- 床か玉と交わる所を 0.3 m の手前から薄くし、刺さった線を見せない -->
        <AdvancedRendererCommonValuesValues>
          <SoftParticleParams>
            <Enabled>True</Enabled>
            <Distance>0.3</Distance>
          </SoftParticleParams>
        </AdvancedRendererCommonValuesValues>
        <DrawingValues>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>30</Center>
                  <Max>30</Max>
                  <Min>30</Min>
                </R>
                <G>
                  <Center>110</Center>
                  <Max>110</Max>
                  <Min>110</Min>
                </G>
                <B>
                  <Center>220</Center>
                  <Max>220</Max>
                  <Min>220</Min>
                </B>
                <A>
                  <Center>128</Center>
                  <Max>128</Max>
                  <Min>128</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>30</Center>
                  <Max>30</Max>
                  <Min>30</Min>
                </R>
                <G>
                  <Center>110</Center>
                  <Max>110</Max>
                  <Min>110</Min>
                </G>
                <B>
                  <Center>220</Center>
                  <Max>220</Max>
                  <Min>220</Min>
                </B>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </Easing>
          </ColorAll>
        </DrawingValues>
      </Node>
      <!-- 殻の光。白水色で明るさ 1 (にじませない)。不透明度 0.5 から寿命の終わりへ 0 -->
      <Node>
        <Name>ShellAdd</Name>
        <CommonValues>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
        </CommonValues>
        <ScalingValues>
          <Type>4</Type>
          <SingleEasing>
            <Start>
              <Center>2.67</Center>
              <Max>2.67</Max>
              <Min>2.67</Min>
            </Start>
            <End>
              <Center>1.55</Center>
              <Max>1.55</Max>
              <Min>1.55</Min>
            </End>
            <Type>21</Type>
          </SingleEasing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/charge_shell.png</ColorTexture>
          <AlphaBlend>2</AlphaBlend>
        </RendererCommonValues>
        <!-- 床か玉と交わる所を 0.3 m の手前から薄くし、刺さった線を見せない -->
        <AdvancedRendererCommonValuesValues>
          <SoftParticleParams>
            <Enabled>True</Enabled>
            <Distance>0.3</Distance>
          </SoftParticleParams>
        </AdvancedRendererCommonValuesValues>
        <DrawingValues>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </R>
                <G>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </G>
                <A>
                  <Center>128</Center>
                  <Max>128</Max>
                  <Min>128</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </R>
                <G>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </G>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </Easing>
          </ColorAll>
        </DrawingValues>
      </Node>
      <!-- 足元の空気の輪。床に寝かせた固定の板 (回転 X 90)。半径 0.5 から 1.2 m へ EaseOutCubic で広がる
           板の大きさ = 半径 × 2 ÷ 0.88 (テクスチャの輪の半径)。玉の中心から 0.62 m 下 (玉の半径 0.65 の少し上) -->
      <Node>
        <Name>FootRingPaint</Name>
        <CommonValues>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
        </CommonValues>
        <LocationValues>
          <Fixed>
            <Location>
              <Y>-0.62</Y>
            </Location>
          </Fixed>
        </LocationValues>
        <RotationValues>
          <Fixed>
            <Rotation>
              <X>90</X>
            </Rotation>
          </Fixed>
        </RotationValues>
        <ScalingValues>
          <Type>4</Type>
          <SingleEasing>
            <Start>
              <Center>1.14</Center>
              <Max>1.14</Max>
              <Min>1.14</Min>
            </Start>
            <End>
              <Center>2.73</Center>
              <Max>2.73</Max>
              <Min>2.73</Min>
            </End>
            <Type>21</Type>
          </SingleEasing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/charge_ring.png</ColorTexture>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>30</Center>
                  <Max>30</Max>
                  <Min>30</Min>
                </R>
                <G>
                  <Center>110</Center>
                  <Max>110</Max>
                  <Min>110</Min>
                </G>
                <B>
                  <Center>220</Center>
                  <Max>220</Max>
                  <Min>220</Min>
                </B>
                <A>
                  <Center>150</Center>
                  <Max>150</Max>
                  <Min>150</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>30</Center>
                  <Max>30</Max>
                  <Min>30</Min>
                </R>
                <G>
                  <Center>110</Center>
                  <Max>110</Max>
                  <Min>110</Min>
                </G>
                <B>
                  <Center>220</Center>
                  <Max>220</Max>
                  <Min>220</Min>
                </B>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </Easing>
          </ColorAll>
          <Sprite>
            <Billboard>2</Billboard>
          </Sprite>
        </DrawingValues>
      </Node>
      <Node>
        <Name>FootRingAdd</Name>
        <CommonValues>
          <Life>
            <Center>6</Center>
            <Max>6</Max>
            <Min>6</Min>
          </Life>
        </CommonValues>
        <LocationValues>
          <Fixed>
            <Location>
              <Y>-0.62</Y>
            </Location>
          </Fixed>
        </LocationValues>
        <RotationValues>
          <Fixed>
            <Rotation>
              <X>90</X>
            </Rotation>
          </Fixed>
        </RotationValues>
        <ScalingValues>
          <Type>4</Type>
          <SingleEasing>
            <Start>
              <Center>1.14</Center>
              <Max>1.14</Max>
              <Min>1.14</Min>
            </Start>
            <End>
              <Center>2.73</Center>
              <Max>2.73</Max>
              <Min>2.73</Min>
            </End>
            <Type>21</Type>
          </SingleEasing>
        </ScalingValues>
        <RendererCommonValues>
          <ColorTexture>Texture/charge_ring.png</ColorTexture>
          <AlphaBlend>2</AlphaBlend>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </R>
                <G>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </G>
                <A>
                  <Center>204</Center>
                  <Max>204</Max>
                  <Min>204</Min>
                </A>
              </Start>
              <End>
                <R>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </R>
                <G>
                  <Center>240</Center>
                  <Max>240</Max>
                  <Min>240</Min>
                </G>
                <A>
                  <Center>0</Center>
                  <Max>0</Max>
                  <Min>0</Min>
                </A>
              </End>
            </Easing>
          </ColorAll>
          <Sprite>
            <Billboard>2</Billboard>
          </Sprite>
        </DrawingValues>
      </Node>
    </Children>
  </Root>
  <ToolVersion>1.80.7</ToolVersion>
  <Version>3</Version>
  <!-- 編集ソフトの再生の範囲。実行側には渡らないが、無いと編集ソフトの読み込みが落ちる -->
  <StartFrame>0</StartFrame>
  <EndFrame>12</EndFrame>
  <IsLoop>False</IsLoop>
</EffekseerProject>
