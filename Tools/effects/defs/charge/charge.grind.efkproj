<?xml version="1.0" encoding="utf-8"?>
<!-- 注: 編集ソフトの読み込みは注釈で落ちる。efkbuild.py が注釈を外した写しを作って渡す
     削る粉 (C3)。溜めに入ったフレーム q から放したフレーム u まで出し続け、
     ChargeEffects が u に消す (空中の粒も消える)
     動的入力 0 番は溜め量 0..1。既定の 1 は efkprobe で溜めきりの姿を見るため -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <!-- 削る粉。玉の輪郭 (半径 0.65 m) の外の左右 0.75 m・後ろ 0.3 m で生み、
           左右へ 1.5〜2.7 m/s・後ろへ 3.6〜4.8 m/s (斜め後ろ)、
           上へ 1.2〜2.4 m/s で低く飛び、重力 9.8 m/s² で落ちる。根の向きは ChargeEffects が狙いの向きで渡す。
           定義の前後は読み込みで反転されるので、定義のプラスはゲームでは狙いの向きの後ろ、マイナスは前。
           下の後ろの位置と速さが定義でプラスなのはそのため
           出た後は世界に残す (生成時だけ親に従う)
           左右だけへ飛ばすと横からの視点で玉の手前と奥に重なって見えず、
           後ろだけへ飛ばすと後ろからの視点で画面の下の外へ出た。
           斜め後ろなら、後ろからの視点では左右へ、横からの視点では後ろへ出て見える。後ろを左右より速くするのは、
           横からの視点で玉の輪郭 (中心から後ろ 0.65 m) の外へ 5 フレームで出すため (左右と同じ速さでは 10
           フレームかかり、
           茶色が玉の暗い升に重なって読めなかった)
           溜めに入ったフレーム q に左右 3 つずつを一度に出す (生成の開始 -1)。この塊だけは後ろ 1.0 m で生み、
           どちらの視点でも 1 フレーム目から玉の輪郭の外に見せる (手本の Sonic Mania
           は溜めに入ったフレームに砂埃が見える)。
           後ろ 0.3 m で生むと、横からの視点では塊 (直径 0.55 m) が玉の輪郭 (後ろ 0.65 m) の内に重なり、
           手前の塊は玉の茶色の升に
           紛れ、奥の塊は玉の裏に隠れて、茶色の粉と分かるのが q + 3 だった。
           後ろからの視点では左右 0.75 m が輪郭の外なので変わらない
           続く塊は 1 フレームに 0.5 + 1.5 × 溜め量 個 (左右で半分ずつ。生成間隔の式)、大きさ 0.55 → 1.05 m、
           寿命 20 フレーム
           色は中間の明るさの茶色で不透明度 0.9 から 0: 白い升の上でも黒い升の上でも明るさで離れる
           (層の表の砂色 (190, 178, 158) は白い床の上で薄かった)。小粒は塊の 2 倍の数で速く飛ぶ暗い茶色の点、
           寿命 14 フレーム -->
      <Node>
        <Name>DustLeft</Name>
        <CommonValues>
          <MaxGeneration>
            <Infinite>True</Infinite>
          </MaxGeneration>
          <Generation>
            <GenerationTime>
              <DynamicEquationMax>0</DynamicEquationMax>
              <DynamicEquationMin>0</DynamicEquationMin>
            </GenerationTime>
          </Generation>
          <LocationEffectType>1</LocationEffectType>
          <RotationEffectType>1</RotationEffectType>
          <ScaleEffectType>1</ScaleEffectType>
          <Life>
            <Center>20</Center>
            <Max>20</Max>
            <Min>20</Min>
          </Life>
        </CommonValues>
        <LocationValues>
          <Type>1</Type>
          <PVA>
            <Location>
              <X>
                <Center>-0.75</Center>
                <Max>-0.75</Max>
                <Min>-0.75</Min>
              </X>
              <Y>
                <Center>-0.5</Center>
