      </DynamicEquation>
      <DynamicEquation>
        <Name>FullChargeCount</Name>
        <Code>@O.x = step(0.999, @In0)</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>BurstScale</Name>
        <Code>@O.x = @In1
@O.y = @In1
@O.z = @In1</Code>
      </DynamicEquation>
      <DynamicEquation>
        <Name>HazeCount</Name>
        <Code>@O.x = 3 + 3 * step(0.5, @In0) + 14 * step(0.999, @In0)</Code>
      </DynamicEquation>
    </Equations>
