<?xml version="1.0" encoding="utf-8"?>
<!-- 注: 編集ソフトの読み込みは注釈で落ちる。efkbuild.py が注釈を外した写しを作って渡す
     放しの弾け (R-P1-4、C6)。放したフレーム u に出し、ChargeEffects が u + 21 に消す
     動的入力 0 番は放した時の溜め量 0..1、1 番は溜めた量で変える層の大きさの倍率 (どちらも出す時だけ読む)。
     既定の 1 は efkprobe で溜めきりの姿を見るため -->
<EffekseerProject>
  <Root>
    <Name>Root</Name>
    <Children>
      <!-- 溜めた量で大きさを変える層 (輪・丸屋根・放射の筋) は空の節 Scaled の子。Scaled の大きさは動的入力 1 番
           (ChargeEffects が 0.75 + 0.25 × 溜め量 で渡す)。はじけの光と散って残る筋は大きさを変えない
           (効果の全体を小さくすると、タップの粒は玉の輪郭の内側で生まれて見えず、
           はじけの光も小さくて画面が明るくならなかった)
           放しの輪は、どの視点からも正面に見える輪 (Billboard 0) で、
           半径 0.8 m から 3.2 m (溜めきり) へ 2 フレームで広がり薄れる。
           タップは 0.75 倍で半径 2.4 m まで。押した瞬間の丸まりの殻 (半径 1.2 m) の倍の大きさにし、殻と見分ける
           (手本の Sonic Frontiers 10.650 秒の丸屋根は放す 1 フレーム前から放した 1 フレーム後まで。
           u と u + 1 に写す)
           輪の光は明るさ 1、溜め量 0.5 から +1.25、溜めきりで +1.25 (合わせて 1 + 2.5 × 溜め量 の段)。
           足す 2 枚は最大生成数の式で出し入れする。
           丸屋根の光は玉を中心に直径 2.0 m から 3.6 m へ広がる柔らかい水色で、
           輪と同じ 2 フレーム。放射の筋 12 本は突進と逆向き (根の -Z) を軸に半角 40 度の円錐へ、
           玉の縁 (半径 0.7) から
           6 m/s で開く。寿命 4 フレーム。円錐の軸は子を X 軸まわりに 90 度回した空の節で決める。
           1 フレーム目に全数が開いた位置で出る (生成の開始 -1) -->
      <Node>
        <Name>Scaled</Name>
        <CommonValues>
        </CommonValues>
        <ScalingValues>
          <Fixed>
            <Scale>
              <DynamicEquation>2</DynamicEquation>
            </Scale>
          </Fixed>
        </ScalingValues>
        <DrawingValues>
          <Type>0</Type>
        </DrawingValues>
        <Children>
