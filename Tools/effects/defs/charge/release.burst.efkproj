          <AlphaBlend>2</AlphaBlend>
          <EmissiveScaling>0.42</EmissiveScaling>
        </RendererCommonValues>
        <DrawingValues>
          <ColorAll>
            <Type>2</Type>
            <Easing>
              <Start>
                <R>
                  <Center>90</Center>
                  <Max>90</Max>
                  <Min>90</Min>
                </R>
                <G>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </G>
              </Start>
              <End>
                <R>
                  <Center>90</Center>
                  <Max>90</Max>
                  <Min>90</Min>
                </R>
                <G>
                  <Center>200</Center>
                  <Max>200</Max>
                  <Min>200</Min>
                </G>
              </End>
            </Easing>
          </ColorAll>
        </DrawingValues>
      </Node>
