      <!-- はじけの光。放した所に残る、中が抜けた柔らかい円 (最も明るいのは直径の 0.55 倍の所)。
           下半分は床に隠れて丸屋根に見える。
           大きさを変えない (タップも溜めきりも同じ大きさ)。
           明るさだけを 1 / +1.25 (溜め量 0.5 から) / +1.25 (溜めきり) の段にする
           u と u + 1 の 2 フレームだけ写す (寿命 1。色が変わらない板は寿命 n で n + 1 フレーム写る)。
           直径 8.0 m から 9.5 m、
           不透明度 1、明るさの倍率 0.42。
           手本の Sonic Frontiers 10.650 秒の丸屋根は放す 1 フレーム前から放した 1 フレーム後まで
           で、+2 には丸屋根の形は無く光のもやと稲妻だけになる。u + 3 まで留めると、
           丸屋根の形の霞が u + 4 まで写った。
           u + 2 から後の明るさは形の無いもや (Haze) が持つ。中が抜けていれば玉の輪郭と溜めきりの閃きが読める。
           放した所に置いたまま付いていかせない -->
      <Node>
        <Name>Halo</Name>
        <CommonValues>
          <Life>
            <Center>1</Center>
            <Max>1</Max>
            <Min>1</Min>
          </Life>
        </CommonValues>
        <ScalingValues>
          <Type>4</Type>
          <SingleEasing>
            <Start>
              <Center>8.0</Center>
              <Max>8.0</Max>
              <Min>8.0</Min>
            </Start>
            <End>
              <Center>9.5</Center>
              <Max>9.5</Max>
              <Min>9.5</Min>
            </End>
            <Type>1</Type>
          </SingleEasing>
        </ScalingValues>
        <RendererCommonValues>
